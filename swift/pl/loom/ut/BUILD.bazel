# Unit tests for Loom (Swift). Same pattern as //swift/pl/aurashot/ut:
# the app library is built without -enable-testing, so the local
# testable_lib recompiles the protocol/store sources with
# -enable-testing and the tests `@testable import Loom`.

load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "testable_lib",
    srcs = ["//swift/pl/loom:sources_for_tests"],
    copts = ["-enable-testing"],
    module_name = "Loom",
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:private"],
)

# bazel test //swift/pl/loom/ut:loom_tests — pure-logic tests: SSE frame
# parser (chunking, CRLF, multiline data, control comments) and wire
# model decoding (RuntimeEvent envelope, payloads, Snapshot, dates).
swift_test(
    name = "loom_tests",
    srcs = glob(["*.swift"]),
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":testable_lib"],
)
