# Loom — pure-SwiftUI peer client of `loom serve`'s REST+events protocol
# (WebSocket-first with SSE fallback, protocol/EventStreamClient.swift).
# Replaces the Wails webview shell with a fully native macOS UI; the Go
# backend is untouched (SERVE_DESIGN §3.1: every frontend is an equal
# pure-rendering client of the /v1 protocol). The loom CLI is embedded
# as a resource and spawned as `loom serve` on app launch.

load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "loom_lib",
    srcs = glob([
        "app/*.swift",
        "protocol/*.swift",
        "store/*.swift",
        "views/*.swift",
    ]),
    module_name = "Loom",
    target_compatible_with = ["@platforms//os:macos"],
)

# Protocol + store sources recompiled with -enable-testing for
# //swift/pl/loom/ut (see the aurashot pattern). The @main entry point
# is excluded (its _main would collide with the test runner's), and so
# are the views — except the markdown block parser's self-contained
# trio, which carries the unit-tested LiveBlockCache/splitBlocks logic.
filegroup(
    name = "sources_for_tests",
    srcs = glob([
        "protocol/*.swift",
        "store/*.swift",
    ]) + [
        "views/MarkdownText.swift",
        "views/MazeAxis.swift",
        "views/MessageViews.swift",
        "views/SyntaxHighlighter.swift",
        "views/Theme.swift",
    ],
    visibility = ["//visibility:public"],
)

macos_application(
    name = "Loom",
    # Reuses the retired Wails build's bundle id: this app is its
    # drop-in replacement, so LaunchServices/TCC records carry over.
    bundle_id = "cc.liubang.loom.desktop",
    bundle_name = "Loom",
    infoplists = ["resources/Info.plist"],
    minimum_os_version = "14.0",
    # AppIcon + the loom CLI: embedded so the app can spawn `loom serve`
    # itself (ServerManager) instead of requiring a user-managed server.
    # highlight.min.js feeds the code-block syntax highlighter
    # (JavaScriptCore bridge in views/SyntaxHighlighter.swift).
    resources = [
        "resources/AppIcon.icns",
        "//go/pl/loom/cmd/loom",
        "@highlight_js//file:highlight.min.js",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":loom_lib"],
)

# bazel run //swift/pl/loom:install — unzip, re-sign with a stable local
# identity, install to /Applications. Launch via `open` (LaunchServices),
# never as a child process of a terminal/IDE.
sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(location :Loom)"],
    data = [
        ":Loom",
        ":make-signing-cert",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# bazel run //swift/pl/loom:make-signing-cert — create the local
# self-signed codesigning identity (idempotent, once per machine).
sh_binary(
    name = "make-signing-cert",
    srcs = ["make-signing-cert.sh"],
    target_compatible_with = ["@platforms//os:macos"],
)
