load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "aurabar_lib",
    srcs = glob([
        "app/*.swift",
        "core/*.swift",
        "modules/calendar/*.swift",
        "modules/gpu/*.swift",
        "modules/stats/*.swift",
        "modules/weather/*.swift",
    ]),
    module_name = "AuraBar",
    target_compatible_with = ["@platforms//os:macos"],
)

# com.apple.weatherkit needs a provisioning profile (paid developer
# account); self-signed local builds must use the empty dev set or the
# kernel refuses to spawn the app. Enable with:
#   bazel build //swift/pl/aurabar:AuraBar --//swift/pl/aurabar:weatherkit
bool_flag(
    name = "weatherkit",
    build_setting_default = False,
)

config_setting(
    name = "weatherkit_enabled",
    flag_values = {":weatherkit": "True"},
)

macos_application(
    name = "AuraBar",
    bundle_id = "cc.liubang.aurabar",
    bundle_name = "AuraBar",
    entitlements = select({
        ":weatherkit_enabled": "resources/AuraBar.entitlements",
        "//conditions:default": "resources/AuraBar.dev.entitlements",
    }),
    infoplists = ["resources/Info.plist"],
    minimum_os_version = "14.0",
    resources = ["resources/AppIcon.icns"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":aurabar_lib"],
)

# bazel run //swift/pl/aurabar:install — unzip, re-sign (auto-discovers
# the local identity, creating it via make-signing-cert when missing) and
# install to /Applications.
sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = [
        "$(location :AuraBar)",
        "$(location resources/AuraBar.entitlements)",
        "$(location resources/AuraBar.dev.entitlements)",
    ],
    data = [
        "resources/AuraBar.dev.entitlements",
        "resources/AuraBar.entitlements",
        ":AuraBar",
        ":make-signing-cert",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# bazel run //swift/pl/aurabar:make-signing-cert — create the local
# self-signed codesigning identity (idempotent, once per machine).
sh_binary(
    name = "make-signing-cert",
    srcs = ["make-signing-cert.sh"],
    target_compatible_with = ["@platforms//os:macos"],
)
