load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "aurabar_lib",
    srcs = glob([
        "app/*.swift",
        "core/*.swift",
        "modules/calendar/*.swift",
        "modules/stats/*.swift",
        "modules/weather/*.swift",
    ]),
    module_name = "AuraBar",
    target_compatible_with = ["@platforms//os:macos"],
)

macos_application(
    name = "AuraBar",
    bundle_id = "cc.liubang.aurabar",
    bundle_name = "AuraBar",
    infoplists = ["resources/Info.plist"],
    minimum_os_version = "14.0",
    resources = ["resources/AppIcon.icns"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":aurabar_lib"],
)

# bazel run //swift/pl/aurabar:install — unzip, re-sign (auto-discovers
# the local identity, creating it via make-signing-cert when missing) and
# install to /Applications.
sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(location :AuraBar)"],
    data = [
        ":AuraBar",
        ":make-signing-cert",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# bazel run //swift/pl/aurabar:make-signing-cert — create the local
# self-signed codesigning identity (idempotent, once per machine).
sh_binary(
    name = "make-signing-cert",
    srcs = ["make-signing-cert.sh"],
    target_compatible_with = ["@platforms//os:macos"],
)
