# Unit tests for AuraBar. Test targets here must NOT depend on
# //swift/pl/aurabar:aurabar_lib directly: that library is built
# without -enable-testing, so `@testable import AuraBar` would fail.
# The local testable_lib recompiles the shared sources with
# -enable-testing and lives in this package so its AuraBar.swiftmodule
# output can't collide with the app's.

load("@rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "testable_lib",
    srcs = ["//swift/pl/aurabar:sources_for_tests"],
    copts = ["-enable-testing"],
    module_name = "AuraBar",
    target_compatible_with = ["@platforms//os:macos"],
    visibility = ["//visibility:private"],
)

# bazel test //swift/pl/aurabar/ut:calendar_tests — pure calendar-logic
# tests (grid math, day keys, solar terms, lunar, holidays).
swift_test(
    name = "calendar_tests",
    srcs = glob(["calendar/*.swift"]),
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":testable_lib"],
)
