load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "aurashot_lib",
    srcs = glob([
        "annotate/*.swift",
        "app/*.swift",
        "capture/*.swift",
        "capture_overlay/*.swift",
        "hotkey/*.swift",
        "ocr/*.swift",
        "output/*.swift",
        "settings/*.swift",
    ]),
    module_name = "AuraShot",
    target_compatible_with = ["@platforms//os:macos"],
)

macos_application(
    name = "AuraShot",
    # NOTE: never reuse cc.liubang.auraclip — its menubar-visibility
    # record is permanently poisoned in Tahoe's secure prefs (bound to
    # a hidden host group after a debug-relaunch mishap; see CLAUDE.md).
    # Current identity: cc.liubang.aurashot.
    bundle_id = "cc.liubang.aurashot",
    bundle_name = "AuraShot",
    entitlements = "resources/AuraShot.entitlements",
    infoplists = ["resources/Info.plist"],
    minimum_os_version = "14.0",
    resources = ["resources/AppIcon.icns"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":aurashot_lib"],
)

# bazel run //swift/pl/aurashot:install — unzip, re-sign with a stable
# local identity (so TCC screen-recording grants survive rebuilds) and
# install to /Applications.
sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = [
        "$(location :AuraShot)",
        "$(location resources/AuraShot.entitlements)",
    ],
    data = [
        "resources/AuraShot.entitlements",
        ":AuraShot",
        ":make-signing-cert",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

# bazel run //swift/pl/aurashot:make-signing-cert — create the local
# self-signed codesigning identity (idempotent, once per machine).
sh_binary(
    name = "make-signing-cert",
    srcs = ["make-signing-cert.sh"],
    target_compatible_with = ["@platforms//os:macos"],
)
