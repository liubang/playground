load("@rules_cc//cc:defs.bzl", "cc_binary")
load(
    "//cpp:copts/configure_copts.bzl",
    "COPTS",
    "LINKOPTS",
)

# Run with optimizations and without sanitizers:
#   bazel run //cpp/pl/prism/benchmark:parser_benchmark --config=release
cc_binary(
    name = "parser_benchmark",
    srcs = ["parser_benchmark.cpp"],
    copts = COPTS,
    linkopts = LINKOPTS,
    deps = [
        "//cpp/pl/prism/plan",
        "//cpp/pl/prism/printer",
        "//cpp/pl/prism/syntax",
        "@nanobench//:nanobench_hdrs",
    ],
)

# Synthetic benchmark workloads, generated by:
#   bazel-bin/cpp/pl/prism/benchmark/parser_benchmark --dump cpp/pl/prism/benchmark/workloads
# Shared with other implementations (e.g. //java/pl/prism Trino comparison).
filegroup(
    name = "workloads",
    srcs = glob(["workloads/*.sql"]),
    visibility = ["//visibility:public"],
)
