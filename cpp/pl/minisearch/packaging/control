# MiniSearch 一键启停：./control start | stop | restart | status
# 配置：conf/minisearch.ini（key=value，本脚本 source 后翻译成两个进程的参数）

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONF="${ROOT}/conf/minisearch.ini"
[[ -f "${CONF}" ]] || {
	echo "missing config: ${CONF}" >&2
	exit 1
}
# shellcheck disable=SC1090
source "${CONF}"

DATA="${DATA_DIR:-data}"
[[ "${DATA}" = /* ]] || DATA="${ROOT}/${DATA}"
# Console 静态文件目录：相对路径解析到包根；WEB_DIR 为空 = 不 serve /console/*
WEB="${WEB_DIR:-}"
[[ -z "${WEB}" || "${WEB}" = /* ]] || WEB="${ROOT}/${WEB}"
LOGD="${ROOT}/log"
RUND="${ROOT}/run"
mkdir -p "${DATA}" "${LOGD}" "${RUND}"

EMBEDDING_ENDPOINT="http://127.0.0.1:${EMBEDDING_PORT}"

embedding_args() {
	local args=(--model "${EMBEDDING_MODEL}" --host "${EMBEDDING_HOST:-127.0.0.1}"
		--port "${EMBEDDING_PORT}" --max-length "${EMBEDDING_MAX_LENGTH:-512}")
	[[ -n "${RERANK_MODEL:-}" ]] && args+=(--rerank-model "${RERANK_MODEL}")
	printf '%s\0' "${args[@]}"
}

minisearch_args() {
	local args=(--port="${MINISEARCH_PORT}" --listen="${LISTEN}" --data_dir="${DATA}"
		--index_type="${INDEX_TYPE:-Flat}"
		--embedding_endpoint="${EMBEDDING_ENDPOINT}" --embedding_model="${EMBEDDING_MODEL}")
	if [[ "${AUTH}" == "true" ]]; then
		args+=(--auth=true)
	else
		args+=(--auth=false)
	fi
	if [[ -n "${RERANK_MODEL:-}" ]]; then
		args+=(--rerank_endpoint="${EMBEDDING_ENDPOINT}" --rerank_model="${RERANK_MODEL}")
	fi
	if [[ -n "${WEB}" ]]; then
		args+=(--web_dir="${WEB}")
	fi
	if [[ -n "${CONSOLE_ADMIN_USER:-}" ]]; then
		args+=(--console_admin_user="${CONSOLE_ADMIN_USER}"
			--console_admin_password="${CONSOLE_ADMIN_PASSWORD:-}")
	fi
	printf '%s\0' "${args[@]}"
}

is_running() { # is_running <pidfile>
	local pid
	pid=$(cat "$1" 2>/dev/null) || return 1
	[[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

start_one() { # start_one <name> <health_url> <args...>
	local name="$1" health="$2"
	shift 2
	local pidfile="${RUND}/${name}.pid"
	if is_running "${pidfile}"; then
		echo "${name} already running (pid $(cat "${pidfile}"))"
		return 0
	fi
	nohup "$@" >"${LOGD}/${name}.log" 2>&1 &
	echo $! >"${pidfile}"
	echo "${name} starting (pid $!), waiting for readiness..."
	for _ in $(seq 1 300); do
		if curl -sf "${health}" >/dev/null 2>&1; then
			echo "${name} ready (${health})"
			return 0
		fi
		if ! is_running "${pidfile}"; then
			echo "${name} died during startup, see log/${name}.log" >&2
			return 1
		fi
		sleep 1
	done
	echo "${name} not ready after 300s, see log/${name}.log" >&2
	return 1
}

stop_one() { # stop_one <name>
	local name="$1" pidfile="${RUND}/$1.pid" pid
	pid=$(cat "${pidfile}" 2>/dev/null)
	if [[ -z "${pid}" ]] || ! kill -0 "${pid}" 2>/dev/null; then
		rm -f "${pidfile}"
		echo "${name} not running"
		return 0
	fi
	kill -TERM "${pid}" 2>/dev/null
	for _ in $(seq 1 100); do
		kill -0 "${pid}" 2>/dev/null || break
		sleep 0.1
	done
	if kill -0 "${pid}" 2>/dev/null; then
		kill -9 "${pid}" 2>/dev/null
		echo "${name} force killed"
	else
		echo "${name} stopped"
	fi
	rm -f "${pidfile}"
}

status_one() { # status_one <name> <health_url>
	local name="$1" health="$2" pid
	pid=$(cat "${RUND}/$1.pid" 2>/dev/null)
	if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
		if curl -sf "${health}" >/dev/null 2>&1; then
			echo "${name}: running (pid ${pid}), health ok"
		else
			echo "${name}: running (pid ${pid}), health check FAILED (${health})"
		fi
	else
		echo "${name}: stopped"
	fi
}

cmd_start() {
	# 先推理服务（模型加载较慢），后检索服务
	local args=()
	while IFS= read -r -d '' a; do args+=("$a"); done < <(embedding_args)
	start_one embedding "${EMBEDDING_ENDPOINT}/health" "${ROOT}/bin/embedding" "${args[@]}" || return 1
	args=()
	while IFS= read -r -d '' a; do args+=("$a"); done < <(minisearch_args)
	start_one minisearch "http://127.0.0.1:${MINISEARCH_PORT}/healthz" \
		"${ROOT}/bin/minisearch" "${args[@]}"
}

cmd_stop() {
	stop_one minisearch # 先停检索服务，保证 final checkpoint flush 完成
	stop_one embedding
}

case "${1:-}" in
start) cmd_start ;;
stop) cmd_stop ;;
restart)
	cmd_stop
	cmd_start
	;;
status)
	status_one minisearch "http://127.0.0.1:${MINISEARCH_PORT}/healthz"
	status_one embedding "${EMBEDDING_ENDPOINT}/health"
	;;
*)
	echo "usage: $0 {start|stop|restart|status}" >&2
	exit 1
	;;
esac
