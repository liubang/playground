{
  "pack": {
    "id": "go-toolchain",
    "name": "Go 工具链",
    "description": "Go 工具链（go mod/download、go build/test/vet/run、gofmt 等）在 macOS 沙箱内无法工作：TLS 验证依赖 Security framework（crypto/x509 读 keychain）、GOMODCACHE/GOCACHE 父目录不可写。开启后这些命令直接在沙箱外运行，不再失败、不再逐次审批。注意：go test/go run 会编译并执行项目代码，unsandboxed 后这些代码获得完整用户权限（可读凭证/keychain）——请在信任本机项目时使用。",
    "risk": "medium",
    "reason": "Go 的 TLS 根证书通过 Security framework 从 keychain 加载，seatbelt 沙箱禁止该访问且无文件级替代方案；缓存目录 ~/go 不在沙箱放行列表。go 命令覆盖构建/测试/运行，均无法沙箱内完成。",
    "commands": [
      "go mod download",
      "go mod tidy",
      "go mod vendor",
      "go build",
      "go test",
      "go vet",
      "go run",
      "go install",
      "go fmt",
      "gofmt",
      "go env",
      "go list"
    ]
  },
  "packages": [
    {
      "bind": {
        "argv_prefix": [
          "go",
          "mod",
          "download"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go mod download: TLS 需 keychain（Security framework），沙箱内必然失败；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "mod",
          "download",
          "github.com/x/y"
        ]
      ],
      "not_match": [
        [
          "go",
          "run",
          "."
        ],
        [
          "go",
          "install",
          "x"
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "mod",
          "tidy"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go mod tidy: 依赖下载同 go mod download；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "mod",
          "tidy"
        ]
      ],
      "not_match": [
        [
          "go",
          "run",
          "."
        ],
        [
          "go",
          "install",
          "x"
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "mod",
          "vendor"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go mod vendor: 依赖下载同 go mod download；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "mod",
          "vendor"
        ]
      ],
      "not_match": [
        [
          "go",
          "run",
          "."
        ],
        [
          "go",
          "install",
          "x"
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "build"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go build: 编译需要 GOCACHE/GOMODCACHE 写权限与 TLS，沙箱内必然失败；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "build",
          "./..."
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "test"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go test: 编译并运行测试代码，需缓存与 TLS；用户已启用 go-toolchain 规则包（注意：测试代码获得完整用户权限）",
      "match": [
        [
          "go",
          "test",
          "./..."
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "vet"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go vet: 静态检查需编译缓存；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "vet",
          "./..."
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "run"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go run: 编译并执行命令（沙箱内无法完成）；用户已启用 go-toolchain 规则包（注意：被运行的程序获得完整用户权限）",
      "match": [
        [
          "go",
          "run",
          "./cmd/x"
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "install"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go install: 下载并安装工具；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "install",
          "golang.org/x/tools/..."
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "fmt"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go fmt: 格式化需要写源码文件与 GOCACHE；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "fmt",
          "./..."
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "gofmt"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "gofmt: 格式化（沙箱内无法定位 GOCACHE 相关缓存）；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "gofmt",
          "-l",
          "main.go"
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "env"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go env: 只读查询 Go 环境；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "env",
          "GOROOT"
        ]
      ]
    },
    {
      "bind": {
        "argv_prefix": [
          "go",
          "list"
        ]
      },
      "decision": "allow",
      "consequence": "confined",
      "grant": {
        "unsandboxed": true
      },
      "justification": "go list: 查询包信息，需模块解析与缓存；用户已启用 go-toolchain 规则包",
      "match": [
        [
          "go",
          "list",
          "./..."
        ]
      ]
    }
  ]
}