diff --git a/tools/bin2c.py b/tools/bin2c.py
new file mode 100644
index 0000000..dd6d96f
--- /dev/null
+++ b/tools/bin2c.py
@@ -0,0 +1,13 @@
+#!/usr/bin/env python3
+# Embed a binary file as a C++ array definition.
+# Usage: bin2c.py SYMBOL INPUT > output.h
+import sys
+
+symbol, path = sys.argv[1], sys.argv[2]
+with open(path, "rb") as f:
+    data = f.read()
+
+print(f"constexpr unsigned char {symbol}[] = {{")
+for i in range(0, len(data), 32):
+    print("    " + ",".join(f"0x{b:02x}" for b in data[i : i + 32]) + ",")
+print("};")
