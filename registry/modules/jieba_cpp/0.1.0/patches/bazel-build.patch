diff --git a/BUILD.bazel b/BUILD.bazel
new file mode 100644
index 0000000..91115f2
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,54 @@
+package(default_visibility = ["//visibility:public"])
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+exports_files(["LICENSE"])
+
+# C++23 #embed requires --embed-dir (clang 19+); generate plain C arrays instead
+# so the library builds with the workspace compiler matrix (C++20, GCC 14 / Apple Clang).
+genrule(
+    name = "dict_le_h",
+    srcs = [
+        "data/dict_le.dat.zst",
+        "tools/bin2c.py",
+    ],
+    outs = ["dict_le.dat.zst.h"],
+    cmd = "python3 $(location tools/bin2c.py) resource_jieba_dict_zst $(location data/dict_le.dat.zst) > $@",
+)
+
+genrule(
+    name = "dict_be_h",
+    srcs = [
+        "data/dict_be.dat.zst",
+        "tools/bin2c.py",
+    ],
+    outs = ["dict_be.dat.zst.h"],
+    cmd = "python3 $(location tools/bin2c.py) resource_jieba_dict_zst $(location data/dict_be.dat.zst) > $@",
+)
+
+cc_library(
+    name = "jieba",
+    srcs = [
+        "src/jieba.cpp",
+        "src/jieba_dict.cpp",
+        "src/jieba_hmm_seg.cpp",
+        "src/jieba_mp_seg.cpp",
+    ],
+    hdrs = [
+        "include/jieba.h",
+        "include/jieba_common.h",
+        "include/jieba_dict.h",
+        "data/jieba_hmm_model.dat",
+        ":dict_be_h",
+        ":dict_le_h",
+    ],
+    includes = [
+        "data",
+        "include",
+    ],
+    deps = [
+        "@abseil-cpp//absl/container:flat_hash_set",
+        "@darts_clone//:darts_clone",
+        "@zstd",
+    ],
+)
