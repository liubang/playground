# 统一格式化工具链（aspect_rules_lint）。
#
# 语言 → 工具映射：
#   Go         → gofumpt（rules_lint 内置，mvdan.cc/gofumpt）
#   Shell      → shfmt（rules_lint 内置；缩进规则见根目录 .editorconfig）
#   Python     → ruff format（rules_lint 内置）
#   YAML       → yamlfmt（rules_lint 内置）
#   C/C++/CUDA → clang-format（toolchains_llvm 提供的 LLVM 19 二进制，
#                尊重根目录 .clang-format；不注册 C++ 编译工具链）
#   JS/CSS/HTML→ prettier（multitool 锁定的 nodejs + prettier，配置见根 .prettierrc）
#   Java       → google-java-format（maven 锁定的 jar，google 风格 2 空格）
#   Starlark   → buildifier（buildifier_prebuilt）
#
# 排除规则：.gitattributes 的 rules-lint-ignored / linguist-generated，
# 以及各工具自身的 ignore 文件（如 .prettierignore）。

load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

# google-java-format 官方发行 jar 的启动封装（jvm_flags 与上游示例一致）。
java_binary(
    name = "java-format",
    jvm_flags = [
        "--add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
        "--add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    main_class = "com.google.googlejavaformat.java.Main",
    runtime_deps = ["@maven//:com_google_googlejavaformat_google_java_format"],
)

# prettier 是 npm 分发的 JS CLI，本身不可直接 exec：
# 用 multitool 锁定的 nodejs 解释执行 prettier.cjs，并固定 .prettierrc 路径，
# 避免依赖运行目录外的配置文件解析。
# 路径在构建期烤进脚本（rules_lint 的 format runner 直接 exec 工具，
# sh_binary 的 args 不会被传递）。sed 分隔符用 |：路径含 /；
# canonical repo 名含 +，对 BRE 替换文本无特殊含义。
genrule(
    name = "prettier_wrapper",
    srcs = [
        "prettier.sh",
        "//:.prettierrc",
        "@multitool//tools/nodejs",
        "@multitool//tools/prettier",
    ],
    outs = ["prettier.gen.sh"],
    cmd = "sed" +
          " -e 's|@NODE@|$(rlocationpath @multitool//tools/nodejs)|g'" +
          " -e 's|@PRETTIER@|$(rlocationpath @multitool//tools/prettier)|g'" +
          " -e 's|@CONFIG@|$(rlocationpath //:.prettierrc)|g'" +
          " $(location prettier.sh) > $@ && chmod +x $@",
)

sh_binary(
    name = "prettier",
    srcs = ["prettier.gen.sh"],
    data = [
        "//:.prettierrc",
        "@multitool//tools/nodejs",
        "@multitool//tools/prettier",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

format_multirun(
    name = "format",
    c = "@llvm_toolchain_llvm//:bin/clang-format",
    cc = "@llvm_toolchain_llvm//:bin/clang-format",
    css = ":prettier",
    cuda = "@llvm_toolchain_llvm//:bin/clang-format",
    go = "@aspect_rules_lint//format:gofumpt",
    html = ":prettier",
    java = ":java-format",
    javascript = ":prettier",
    python = "@aspect_rules_lint//format:ruff",
    shell = "@aspect_rules_lint//format:shfmt",
    starlark = "@buildifier_prebuilt//:buildifier",
    yaml = "@aspect_rules_lint//format:yamlfmt",
)
